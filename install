#!/usr/bin/env bash
#
# Install a skill from this repo where both Codex and Claude Code will see it.
#
#   ./install <skill> global          -> ~/.agents/skills/<skill>
#   ./install <skill> <project-path>  -> <project-path>/.agents/skills/<skill>
#
# Two links are made for each install:
#
#   <base>/.agents/skills/<skill>  ->  <this repo>/<skill>
#   <base>/.claude/skills/<skill>  ->  ../../.agents/skills/<skill>
#
# .agents/skills is the shared location Codex reads. Claude Code reads
# .claude/skills, so that one is a relative link over to .agents; a link to a
# link resolves fine. Editing a skill here updates every place it is
# installed.
#
# Re-running is a no-op if the links are already right. A link that resolves
# to this repo's copy of the skill but by a different route (say, an older
# direct link) is replaced. Anything else in the way is an error.

set -euo pipefail

usage() {
  echo "usage: $0 <skill> (global | <project-path>)" >&2
  exit 2
}

[ $# -eq 2 ] || usage

skill=$1
target=$2

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
src="$repo/$skill"

if [ ! -f "$src/SKILL.md" ]; then
  echo "error: no skill named '$skill' in $repo (expected $src/SKILL.md)" >&2
  echo "available:" >&2
  for d in "$repo"/*/; do
    [ -f "$d/SKILL.md" ] && echo "  $(basename "$d")" >&2
  done
  exit 1
fi

if [ "$target" = global ]; then
  base=$HOME
else
  if [ ! -d "$target" ]; then
    echo "error: project path '$target' is not a directory" >&2
    exit 1
  fi
  base=$(cd "$target" && pwd -P)
fi

# link DEST TARGET: make DEST a symlink to TARGET, or leave it alone if it
# already is, or replace it if it is our own link by another route.
link() {
  local dest=$1 want=$2 have

  if [ -L "$dest" ]; then
    have=$(readlink "$dest")
    if [ "$have" = "$want" ]; then
      echo "ok:        $dest -> $want"
      return
    fi
    if [ "$(readlink -f "$dest")" = "$src" ]; then
      rm "$dest"
      echo "replaced:  $dest (was -> $have)"
    else
      echo "error: $dest is a symlink to $have, not to this repo" >&2
      echo "remove it first if you want to replace it" >&2
      exit 1
    fi
  elif [ -e "$dest" ]; then
    echo "error: $dest already exists and is not a symlink" >&2
    exit 1
  fi

  mkdir -p "$(dirname "$dest")"
  ln -s "$want" "$dest"
  echo "installed: $dest -> $want"
}

link "$base/.agents/skills/$skill" "$src"
link "$base/.claude/skills/$skill" "../../.agents/skills/$skill"
