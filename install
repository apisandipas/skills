#!/usr/bin/env bash
#
# Install skills and pi config from this repo.
#
#   ./install <skill> global          -> install one skill user-wide
#   ./install <skill> <project-path>  -> install one skill for a project
#   ./install all global              -> install every skill and pi config
#   ./install all <project-path>      -> install every skill for a project
#   ./install pi global               -> install pi config only
#
# Skills:
#   <base>/.agents/skills/<skill>  ->  <this repo>/skills/<skill>
#   <base>/.claude/skills/<skill>  ->  ../../.agents/skills/<skill>
#
# pi config:
#   ~/.pi/agent/settings.json       ->  <this repo>/configs/pi/agent/settings.json
#   ~/.pi/agent/extensions/*        ->  <this repo>/configs/pi/agent/extensions/*
#   ~/.pi/agent/themes/*            ->  <this repo>/configs/pi/agent/themes/*
#
# Re-running is a no-op if the links are already right. A link that resolves
# to this repo's copy by a different route is replaced, as is a dangling link.
# A regular file with the same content as the repo copy is adopted. Anything
# else in the way is an error.

set -euo pipefail

usage() {
  cat >&2 <<EOF
usage: $0 (<skill> | all | pi) (global | <project-path>)

examples:
  $0 my-network global
  $0 all global
  $0 new-project ~/Dev/some-project
  $0 pi global
EOF
  exit 2
}

[ $# -eq 2 ] || usage

what=$1
target=$2

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)

if [ "$target" = global ]; then
  base=$HOME
else
  if [ ! -d "$target" ]; then
    echo "error: project path '$target' is not a directory" >&2
    exit 1
  fi
  base=$(cd "$target" && pwd -P)
fi

link_path() {
  local dest=$1 want=$2 own=${3:-$2} have

  if [ -L "$dest" ]; then
    have=$(readlink "$dest")
    if [ "$have" = "$want" ]; then
      echo "ok:        $dest -> $want"
      return
    fi
    if [ ! -e "$dest" ] || [ "$(readlink -f "$dest")" = "$own" ]; then
      rm "$dest"
      echo "replaced:  $dest (was -> $have)"
    elif [ -f "$dest" ] && [ -f "$own" ] && cmp -s "$dest" "$own"; then
      rm "$dest"
      echo "adopted:   $dest (was -> $have)"
    else
      echo "error: $dest is a symlink to $have, not to this repo" >&2
      echo "remove it first if you want to replace it" >&2
      exit 1
    fi
  elif [ -e "$dest" ]; then
    if [ -f "$dest" ] && [ -f "$own" ] && cmp -s "$dest" "$own"; then
      rm "$dest"
      echo "adopted:   $dest"
    else
      echo "error: $dest already exists and does not match this repo" >&2
      exit 1
    fi
  fi

  mkdir -p "$(dirname "$dest")"
  ln -s "$want" "$dest"
  echo "installed: $dest -> $want"
}

list_skills() {
  local d
  for d in "$repo"/skills/*/; do
    [ -f "$d/SKILL.md" ] && basename "$d"
  done
}

install_skill() {
  local skill src
  skill=$1
  src="$repo/skills/$skill"

  if [ ! -f "$src/SKILL.md" ]; then
    echo "error: no skill named '$skill' in $repo (expected $src/SKILL.md)" >&2
    echo "available:" >&2
    list_skills | sed 's/^/  /' >&2
    exit 1
  fi

  link_path "$base/.agents/skills/$skill" "$src" "$src"
  link_path "$base/.claude/skills/$skill" "../../.agents/skills/$skill" "$src"
}

install_pi() {
  if [ "$target" != global ]; then
    echo "error: pi config can only be installed with target 'global'" >&2
    exit 1
  fi

  local src_root="$repo/configs/pi/agent" src rel
  if [ ! -d "$src_root" ]; then
    echo "error: no pi config found at $src_root" >&2
    exit 1
  fi

  while IFS= read -r -d '' src; do
    rel=${src#"$src_root"/}
    link_path "$HOME/.pi/agent/$rel" "$src" "$src"
  done < <(find "$src_root" -type f -print0 | sort -z)
}

case "$what" in
  all)
    while IFS= read -r skill; do
      install_skill "$skill"
    done < <(list_skills)
    if [ "$target" = global ]; then
      install_pi
    fi
    ;;
  pi)
    install_pi
    ;;
  *)
    install_skill "$what"
    ;;
esac
